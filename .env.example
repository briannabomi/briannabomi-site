# Canonical public origin, including https://
PUBLIC_SITE_URL=https://www.briannabomi.com
NEXT_PUBLIC_SITE_URL=https://www.briannabomi.com

# live | placeholder | disabled
# placeholder is rejected in production and never sends or stores an email.
SIGNUP_MODE=disabled

# Server-only Kit API v4 configuration. Never expose these as NEXT_PUBLIC_*.
KIT_API_KEY=replace-with-a-server-secret
KIT_FORM_ID=replace-with-the-dedicated-form-id
# KIT_API_BASE_URL=https://api.kit.com/v4
# Required for live production. The current process-local limiter is development
# only; production signup stays fail-closed until a distributed platform limiter
# is connected in lib/server/signup-rate-limit.ts.
SIGNUP_HASH_SECRET=replace-with-a-random-server-secret

# Reviewed public destinations
NEXT_PUBLIC_PRIVACY_URL=/sexbydesign/privacy
NEXT_PUBLIC_SUPPORT_URL=/contact
